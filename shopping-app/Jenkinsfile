pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('shopping-app') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('shopping-app') {
                    bat 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('shopping-app') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('shopping-app') {
                    script {
                        docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-creds') {
                            bat '''
                            if not exist "%DOCKER_CONFIG%\\cli-plugins" mkdir "%DOCKER_CONFIG%\\cli-plugins"
        
                            copy /Y "C:\\Windows\\system32\\config\\systemprofile\\.docker\\cli-plugins\\docker-buildx.exe" "%DOCKER_CONFIG%\\cli-plugins\\docker-buildx.exe"
        
                            docker buildx version
        
                            docker buildx build --platform linux/amd64 --push -t thedevcodes1/product-service:%BUILD_NUMBER% -t thedevcodes1/product-service:latest .
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy to Render') {
            steps {
                withCredentials([string(
                    credentialsId: 'render-deploy-hook',
                    variable: 'RENDER_DEPLOY_HOOK'
                )]) {
                    bat '''
                        curl.exe --fail --silent --show-error -X POST "%RENDER_DEPLOY_HOOK%"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed. Check the console output.'
        }
    }
}
