pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('shopping-app') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('shopping-app') {
                    bat 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('shopping-app') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('shopping-app') {
                    script {
                        docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-creds') {
                            bat 'echo DOCKER_CONFIG=%DOCKER_CONFIG%'
                            bat 'docker buildx version'
                            bat 'docker buildx ls'
                            bat "docker buildx build --platform linux/amd64 --push -t thedevcodes1/product-service:${env.BUILD_NUMBER} ."
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed. Check the console output.'
        }
    }
}
